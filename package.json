{
  "name": "pkguled-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:pkguled-web": "node dist/pkguled-web/server/server.mjs",
